# Discord bot secret
TOKEN=

# Command prefix
PREFIX=!

# Core server IDs
TARGET_ROLE_ID=
MOD_ROLE_ID=
MUTE_ROLE_ID=
MEMBER_ROLE_ID=
LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=

# Applications
APP_CHANNEL_ID=
MOD_APP_ROLE_ID=
EVENT_APP_ROLE_ID=
HELPER_APP_ROLE_ID=

# Tickets
TICKET_SUPPORT_ROLE_ID=

# Web panel
PANEL_PASSWORD=
PANEL_PORT=3001

# Role groups. Put several IDs separated by commas.
# Leave optional groups empty if the feature is not used.
# The singular MOD_ROLE_ID above is also accepted as the moderator role.
DIRECTOR_ROLE_IDS=
DEPUTY_ROLE_IDS=
MOD_PLUS_ROLE_IDS=
MOD_ROLE_IDS=
APPS_ROLE_IDS=
REPRIMAND_ROLE_IDS=
ADMIN_ROLE_ID=
REVIEW_ROLE_IDS=
TICKET_MOD_ROLE_IDS=

# Economy
ECONOMY_STARTING_BALANCE=1000
ECONOMY_MAX_BET=1000000
ECONOMY_ADMIN_ROLE_ID=
ECONOMY_GUILD_ID=
ECONOMY_CURRENCY=монет
ECONOMY_STARTING_BANK=0
# 0 means unlimited
ECONOMY_MAX_CASH=0
ECONOMY_MAX_BANK=0
ECONOMY_WORK_MIN=100
ECONOMY_WORK_MAX=300
ECONOMY_DAILY_MIN=500
ECONOMY_DAILY_MAX=1000
ECONOMY_WEEKLY_MIN=1500
ECONOMY_WEEKLY_MAX=3000

# Developer-only commands (!reload, !backup, !withdraw, !give-money, ...)
DEVELOPER_USER_IDS=
DEVELOPER_ROLE_IDS=

# ── ИИ (Groq) ──────────────────────────────────────────────────
# Ключ с https://console.groq.com/keys
GROQ_API_KEY=
AI_ENABLED=true
# Каналы, где бот отвечает как ИИ (через запятую)
AI_CHANNEL_IDS=1537056437115560036
# Основная модель ИИ (Groq)
AI_MODEL=openai/gpt-oss-20b
# Глубина рассуждений для gpt-oss: low | medium | high
AI_REASONING_EFFORT=low
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=800
AI_HISTORY_LIMIT=10
AI_SYSTEM_PROMPT=
# ID штатных ролей, о которых ИИ рассказывает состав
AI_ROLE_MODERATOR_ID=
AI_ROLE_LEGENDARY_ID=
AI_ROLE_DEPUTY_ID=
AI_ROLE_DIRECTOR_ID=

# Запасные модели ИИ (через запятую), если у основной кончился дневной лимит
AI_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Экономия токенов Groq
AI_MAX_TOKENS=500
AI_HISTORY_LIMIT=4
AI_MAX_TOOL_STEPS=3
AI_USER_COOLDOWN_MS=8000

# Ивент-бан
EVENT_BAN_ROLE_ID=1496527474811469927
EVENT_BAN_MOD_ROLE_IDS=1478325069154353304,1291703232212500510,1486307269254709248,1291703538648354867,1348156005531390033,1481276647398178970

# Доп. префиксы команд (через запятую), по умолчанию "/"
EXTRA_PREFIXES=/
